rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function bounded() { return request.method == 'get' || request.query.limit != null && request.query.limit <= 200; }
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function admin() { return signed() && exists(/databases/$(database)/documents/hf_admins/$(request.auth.uid)) && get(/databases/$(database)/documents/hf_admins/$(request.auth.uid)).data.is_active == true; }
    function companyAdmin(b) { return signed() && exists(/databases/$(database)/documents/hf_businesses/$(b)/members/$(request.auth.uid)) && member(b).is_active == true && member(b).permissions.get('company_admin',false) == true; }
    function managesUser(uid) { return signed() && exists(/databases/$(database)/documents/hf_accounts/$(uid)) && owner(get(/databases/$(database)/documents/hf_accounts/$(uid)).data.business_id); }
    function owner(b) { let business = get(/databases/$(database)/documents/hf_businesses/$(b)).data; return signed() && business.get('_migration_state','complete') != 'in_progress' && business.get('_archived',false) != true && (business.owner_user_id == request.auth.uid || admin() || companyAdmin(b)); }
    function member(b) { return get(/databases/$(database)/documents/hf_businesses/$(b)/members/$(request.auth.uid)).data; }
    function active(b) { return signed() && get(/databases/$(database)/documents/hf_businesses/$(b)).data.get('_migration_state','complete') != 'in_progress' && get(/databases/$(database)/documents/hf_businesses/$(b)).data.get('_archived',false) != true && (exists(/databases/$(database)/documents/hf_businesses/$(b)/members/$(request.auth.uid)) ? (member(b).is_active == true || admin()) : admin()); }
    function permission(b,key) { let m=member(b); return active(b) && m.is_active == true && (m.role == 'owner' || m.permissions.get('company_admin',false) || m.permissions.get(key,key in ['record_payments','close_visits'])); }
    function scope(b, facility) { return facility != '' && facility in member(b).get('facility_ids', []); }
    function rec(b,t,id) { return get(/databases/$(database)/documents/hf_businesses/$(b)/records/$(t + '~' + id)).data; }
    function after(b,t,id) { return getAfter(/databases/$(database)/documents/hf_businesses/$(b)/records/$(t + '~' + id)).data; }
    function assigned(b,id) { return request.auth.uid in rec(b,'appointments',id).assigned_users; }
    function invite(id) { return get(/databases/$(database)/documents/hf_invites/$(id)).data; }
    function accepts(id,b) { let i = invite(id); return signed() && get(/databases/$(database)/documents/hf_businesses/$(b)).data.get('_archived',false) != true && i.business_id == b && i.email == request.auth.token.email.lower() && i.accepted_at == null && i.revoked_at == null && i.expires_at_ms > request.time.toMillis() && getAfter(/databases/$(database)/documents/hf_invites/$(id)).data.accepted_by == request.auth.uid; }
    function auditProof(d,b) {
      let revision=getAfter(/databases/$(database)/documents/hf_businesses/$(b)/state/revision).data.value;
      let target=path('/databases/' + database + '/documents/' + d.target_path);
      return d.business_id == b && d.revision == revision && revision == get(/databases/$(database)/documents/hf_businesses/$(b)/state/revision).data.value + 1 && (d.target_path.matches('hf_businesses/' + b + '/(records|finance|billing|payment_contacts|members|catalogue|visit_guards)/[^/]+') || d.target_path.matches('hf_invites/[^/]+')) && (d.operation == 'delete' ? exists(target) && !existsAfter(target) : d.operation == 'write' && getAfter(target).data.get('_audit_revision',-1) == revision && (!exists(target) || getAfter(target).data.diff(get(target).data).affectedKeys().difference(['_audit_revision'].toSet()).size() > 0));
    }
    function roleProof(d,b) {
      let target=path('/databases/' + database + '/documents/' + d.target_path);
      let changed=getAfter(target).data;
      return d.target_path == 'hf_businesses/' + b + '/members/' + d.details.target_user_id && changed.user_id == d.details.target_user_id && (d.details.role == 'owner' ? changed.role == 'owner' : changed.role == 'employee' && changed.permissions.get('company_admin',false) == (d.details.role == 'admin')) && d.details.role in ['owner','admin','employee'];
    }
    match /hf_admins/{uid} {
      allow get: if signed() && (request.auth.uid == uid || admin());
      allow list: if admin();
      // Only an existing verified platform admin can change this registry.
      // Self-revocation is forbidden; every change requires an immutable audit.
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['email','is_active','updated_at','audit_id','default_business_id']) && request.resource.data.is_active is bool && (uid != request.auth.uid || request.resource.data.is_active == true) && request.resource.data.email == get(/databases/$(database)/documents/hf_users/$(uid)).data.email && getAfter(/databases/$(database)/documents/hf_admin_audit/$(request.resource.data.audit_id)).data.actor_id == request.auth.uid && getAfter(/databases/$(database)/documents/hf_admin_audit/$(request.resource.data.audit_id)).data.details.target_user_id == uid;
      allow delete: if false;
    }
    match /hf_admin_audit/{id} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.keys().hasOnly(['actor_id','action','business_id','created_at','details','target_path','operation','revision']) && request.resource.data.actor_id == request.auth.uid && request.resource.data.created_at == request.time && (request.resource.data.action == 'admin_access_changed' && getAfter(/databases/$(database)/documents/hf_admins/$(request.resource.data.details.target_user_id)).data.audit_id == id && getAfter(/databases/$(database)/documents/hf_admins/$(request.resource.data.details.target_user_id)).data.is_active == request.resource.data.details.is_active || request.resource.data.action == 'business_role_changed' && roleProof(request.resource.data,request.resource.data.business_id) && auditProof(request.resource.data,request.resource.data.business_id));
      allow update, delete: if false;
    }
    match /hf_users/{uid} {
      allow get: if signed() && (uid == request.auth.uid || admin() || managesUser(uid));
      allow list: if admin();
      allow create, update: if signed() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','email','display_name','updated_at','_audit_revision']) && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email.lower() && request.resource.data.display_name is string;
      allow delete: if false;
    }
    match /hf_accounts/{uid} {
      allow get: if signed() && (uid == request.auth.uid || admin() || managesUser(uid));
      allow create: if (admin() && request.resource.data.keys().hasOnly(['business_id']) && getAfter(/databases/$(database)/documents/hf_businesses/$(request.resource.data.business_id)/members/$(uid)).data.is_active == true) || (signed() && uid == request.auth.uid && (
        (request.resource.data.keys().hasOnly(['business_id']) && request.resource.data.business_id == uid && getAfter(/databases/$(database)/documents/hf_businesses/$(uid)).data.owner_user_id == uid) ||
        (request.resource.data.keys().hasOnly(['business_id','invite_id']) && accepts(request.resource.data.invite_id,request.resource.data.business_id))
      ));
      allow update: if (admin() || owner(resource.data.business_id) && request.resource.data.business_id == resource.data.business_id || signed() && uid == request.auth.uid && request.resource.data.business_id == resource.data.business_id && request.resource.data.keys().hasOnly(['business_id','invite_id']) && accepts(request.resource.data.invite_id,resource.data.business_id)) && request.resource.data.keys().hasOnly(['business_id','invite_id']) && getAfter(/databases/$(database)/documents/hf_businesses/$(request.resource.data.business_id)/members/$(uid)).data.is_active == true;
      allow list: if admin();
      allow delete: if false;
    }
    match /hf_invites/{id} {
      allow get: if signed() && (admin() || owner(resource.data.business_id) || resource.data.email == request.auth.token.email.lower());
      allow list: if signed() && owner(resource.data.business_id);
      allow create: if owner(request.resource.data.business_id) && request.resource.data.keys().hasOnly(['business_id','email','link_token','role','expires_at','expires_at_ms','accepted_at','revoked_at','_audit_revision']) && request.resource.data.get('role','employee') in ['employee','admin'] && request.resource.data.accepted_at == null && request.resource.data.revoked_at == null && request.resource.data.email is string && request.resource.data.expires_at_ms > request.time.toMillis() && request.resource.data.expires_at_ms <= request.time.toMillis() + 604800000;
      allow update: if (
        owner(resource.data.business_id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked_at','_audit_revision'])
      ) || (
        signed() && resource.data.email == request.auth.token.email.lower() && resource.data.accepted_at == null && resource.data.revoked_at == null && resource.data.expires_at_ms > request.time.toMillis() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted_at','accepted_by']) && request.resource.data.accepted_by == request.auth.uid && getAfter(/databases/$(database)/documents/hf_accounts/$(request.auth.uid)).data.business_id == resource.data.business_id
      );
      allow delete: if false;
    }
    match /hf_businesses/{b} {
      allow get: if signed() && (b == request.auth.uid || active(b));
      allow list: if admin();
      allow create: if signed() && b == request.auth.uid && request.resource.data.owner_user_id == request.auth.uid && request.resource.data.owner_email == request.auth.token.email && !exists(/databases/$(database)/documents/hf_accounts/$(request.auth.uid)) && request.resource.data.keys().hasOnly(['name','owner_user_id','owner_email','created_at','payment_contacts_schema','workflow_schema','finance_schema']) && request.resource.data.payment_contacts_schema == 1 && request.resource.data.workflow_schema == 2 && request.resource.data.finance_schema == 3 && getAfter(/databases/$(database)/documents/hf_businesses/$(b)/members/$(request.auth.uid)).data.role == 'owner';
      allow update: if (owner(b) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])) || (owner(b) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner_user_id','owner_email']) && request.resource.data.owner_email == get(/databases/$(database)/documents/hf_users/$(request.resource.data.owner_user_id)).data.email && getAfter(/databases/$(database)/documents/hf_businesses/$(b)/members/$(request.resource.data.owner_user_id)).data.role == 'owner' && getAfter(/databases/$(database)/documents/hf_accounts/$(request.resource.data.owner_user_id)).data.business_id == b && (!existsAfter(/databases/$(database)/documents/hf_businesses/$(b)/members/$(resource.data.owner_user_id)) || getAfter(/databases/$(database)/documents/hf_businesses/$(b)/members/$(resource.data.owner_user_id)).data.role == 'employee'));
      allow delete: if false;
      match /members/{uid} {
        function validDirector() { let chief=getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id; return request.resource.data.role == (uid == chief ? 'owner' : 'employee') && (uid != chief || request.resource.data.is_active == true); }
        allow get: if signed() && (request.auth.uid == uid || owner(b));
        allow list: if owner(b);
        allow create: if validDirector() && request.resource.data.keys().hasOnly(['id','user_id','business_id','role','display_name','is_active','facility_ids','permissions','onboarding_completed','setup_completed','_audit_revision']) && request.resource.data.id == uid && request.resource.data.user_id == uid && request.resource.data.business_id == b && (
          (owner(b) && request.resource.data.role in ['owner','employee'] && request.resource.data.is_active == true) ||
          (signed() && uid == request.auth.uid && b == uid && getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id == uid && request.resource.data.role == 'owner') ||
          (signed() && uid == request.auth.uid && request.resource.data.role == 'employee' && request.resource.data.is_active == true && request.resource.data.facility_ids == [] && (request.resource.data.permissions == {'record_payments':true,'close_visits':true} && invite(getAfter(/databases/$(database)/documents/hf_accounts/$(uid)).data.invite_id).get('role','employee') == 'employee' || request.resource.data.permissions == {'record_payments':true,'close_visits':true,'company_admin':true} && invite(getAfter(/databases/$(database)/documents/hf_accounts/$(uid)).data.invite_id).get('role','employee') == 'admin') && accepts(getAfter(/databases/$(database)/documents/hf_accounts/$(uid)).data.invite_id,b))
        );
        allow update: if validDirector() && ((signed() && uid == request.auth.uid && resource.data.role != 'owner' && request.resource.data.role == 'employee' && request.resource.data.user_id == uid && request.resource.data.id == uid && request.resource.data.business_id == b && request.resource.data.is_active == true && request.resource.data.facility_ids == [] && (request.resource.data.permissions == {'record_payments':true,'close_visits':true} && invite(getAfter(/databases/$(database)/documents/hf_accounts/$(uid)).data.invite_id).get('role','employee') == 'employee' || request.resource.data.permissions == {'record_payments':true,'close_visits':true,'company_admin':true} && invite(getAfter(/databases/$(database)/documents/hf_accounts/$(uid)).data.invite_id).get('role','employee') == 'admin') && accepts(getAfter(/databases/$(database)/documents/hf_accounts/$(uid)).data.invite_id,b)) || (owner(b) && request.resource.data.id == uid && request.resource.data.user_id == uid && request.resource.data.business_id == b && request.resource.data.role in ['owner','employee'] && (getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id != uid || (request.resource.data.role == 'owner' && request.resource.data.is_active == true))) || (owner(b) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name','is_active','permissions','facility_ids','onboarding_completed','setup_completed','_audit_revision']) && (resource.data.role != 'owner' || request.resource.data.is_active == true)) ||
          (active(b) && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboarding_completed']) && request.resource.data.onboarding_completed == true));
        allow delete: if admin() && getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id != uid;
      }
      match /state/revision {
        allow read: if active(b);
        allow create: if signed() && b == request.auth.uid && getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id == request.auth.uid && request.resource.data.value == 0;
        allow update: if signed() && get(/databases/$(database)/documents/hf_businesses/$(b)).data.get('_archived',false) != true && (active(b) || getAfter(/databases/$(database)/documents/hf_businesses/$(b)/members/$(request.auth.uid)).data.is_active == true) && request.resource.data.keys().hasOnly(['value']) && request.resource.data.value == resource.data.value + 1;
        allow delete: if false;
      }
      match /catalogue/main {
        allow read: if active(b);
        allow create: if owner(b) || (signed() && b == request.auth.uid && getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id == request.auth.uid);
        allow update: if owner(b);
        allow delete: if false;
      }
      match /audit/{id} {
        allow read: if owner(b);
        allow create: if signed() && request.resource.data.id == id && request.resource.data.actor_id == request.auth.uid && request.resource.data.created_at == request.time && request.resource.data.keys().hasOnly(['id','actor_id','action','record_id','details','created_at','business_id','target_path','operation','revision']) && (request.resource.data.action == 'data_changed' && request.resource.data.details == {} || owner(b) && request.resource.data.action == 'business_role_changed' && roleProof(request.resource.data,b)) && auditProof(request.resource.data,b);
        allow update, delete: if false;
      }
      match /billing/{id} {
        allow read: if owner(b) || (permission(b,'view_billing') && scope(b,resource.data._facility_id));
        allow create, update: if (owner(b) || permission(b,'view_billing')) && request.resource.data.user_id == getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id && request.resource.data.business_id == b && request.resource.data.keys().hasOnly(['id','user_id','business_id','_table','_facility_id','customer_id','billing_name','street','postal_code','city','phone','email','payment_method_id','delivery','created_at','updated_at','_audit_revision']) && (owner(b) || scope(b,rec(b,'customers',request.resource.data.customer_id).facility_id));
        allow delete: if owner(b);
      }
      match /payment_contacts/{id} {
        function contactPermission(d) {
          return permission(b,'view_billing') && scope(b,d._facility_id);
        }
        function validContact() {
          let d = request.resource.data;
          let payment = after(b,'treatment_payments',id);
          let treatment = after(b,'treatments',d.treatment_id);
          return d.keys().hasAll(['id','treatment_id','business_id','user_id','_facility_id','billing_name_snapshot','billing_address_snapshot']) && d.keys().hasOnly(['id','treatment_id','business_id','user_id','_facility_id','billing_name_snapshot','billing_address_snapshot','_audit_revision']) &&
            d.id == id && payment.treatment_id == d.treatment_id && d.business_id == b &&
            d.user_id == getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id &&
            d._facility_id == treatment._facility_id && d.billing_name_snapshot is string && d.billing_name_snapshot.size() <= 500 && d.billing_address_snapshot is string && d.billing_address_snapshot.size() <= 2000;
        }
        allow read: if owner(b) || (bounded() && active(b) && contactPermission(resource.data));
        allow create, update: if validContact() && (owner(b) || (active(b) && contactPermission(request.resource.data) && assigned(b,after(b,'treatments',request.resource.data.treatment_id).appointment_id)));
        allow delete: if owner(b) || (active(b) && contactPermission(resource.data) && assigned(b,rec(b,'treatments',resource.data.treatment_id).appointment_id));
      }
      function guard(b,a,shard) { return getAfter(/databases/$(database)/documents/hf_businesses/$(b)/visit_guards/$(a + '~' + string(shard))).data; }
      function settled(b,a,shard) { return guard(b,a,shard).pending_ids.size() == 0; }
      function terminal(d) { return d.status in ['Erledigt','Nicht durchgeführt']; }
      match /visit_guards/{id} {
        function removedValid(ids,i,a) {
          return ids.size() <= i || (after(b,'appointment_customers',ids[i]).appointment_id == a && terminal(after(b,'appointment_customers',ids[i])));
        }
        function baseGuard() {
          let d = request.resource.data;
          return d.keys().hasOnly(['appointment_id','shard','pending_ids','_facility_id','_audit_revision']) && d.shard is int && d.shard >= 0 && d.shard < 6 && id == d.appointment_id + '~' + string(d.shard) && d.pending_ids is list && d.pending_ids.size() <= 350 && d.pending_ids.toSet().size() == d.pending_ids.size() && d._facility_id == after(b,'appointments',d.appointment_id)._facility_id && after(b,'appointments',d.appointment_id).status != 'Abgeschlossen' && (owner(b) || active(b) && request.auth.uid in after(b,'appointments',d.appointment_id).assigned_users);
        }
        allow read: if owner(b) || (bounded() && active(b) && scope(b,resource.data._facility_id));
        allow create: if baseGuard();
        allow update: if baseGuard() && request.resource.data.appointment_id == resource.data.appointment_id && request.resource.data.shard == resource.data.shard && request.resource.data._facility_id == resource.data._facility_id && resource.data.pending_ids.removeAll(request.resource.data.pending_ids).size() <= 4 && removedValid(resource.data.pending_ids.removeAll(request.resource.data.pending_ids),0,resource.data.appointment_id) && removedValid(resource.data.pending_ids.removeAll(request.resource.data.pending_ids),1,resource.data.appointment_id) && removedValid(resource.data.pending_ids.removeAll(request.resource.data.pending_ids),2,resource.data.appointment_id) && removedValid(resource.data.pending_ids.removeAll(request.resource.data.pending_ids),3,resource.data.appointment_id);
        allow delete: if false;
      }
      match /records/{id} {
        function validBase() {
          let d = request.resource.data;
          return d.id is string && id == d._table + '~' + d.id && d.business_id == b && d.user_id == getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.owner_user_id && d._facility_id is string && getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.get('workflow_schema',0) == 2 && (d._table != 'treatments' || d.keys().hasOnly(['id','user_id','business_id','_table','_facility_id','created_at','appointment_id','appointment_customer_id','customer_id','performed_by','start_ms','end_ms','duration_ms','notes','service_snapshots','_audit_revision'])) && getAfter(/databases/$(database)/documents/hf_businesses/$(b)).data.get('finance_schema',0) == 3 && (d._table in ['services','facility_service_prices'] ? d.price_cents is int && d.price_cents >= 0 && d.price_cents <= 900000000000 && !d.keys().hasAny(['price']) : true) && d._table != 'customer_billing' && (d._table != 'treatment_payments' || d.keys().hasOnly(['id','user_id','business_id','_table','_facility_id','created_at','treatment_id','payment_method_id','method_name_snapshot','status','delivery','recorded_by','recorded_at','_audit_revision'])) && !d.keys().hasAny(['total_price','material_cost','price_override','total_cents','material_cents','override_cents','price_snapshot','amount','permissions','role','billing_name_snapshot','billing_address_snapshot']);
        }
        function validVisit(d,creating) {
          let start = d.get('actual_start_ms',null);
          let end = d.get('actual_end_ms',null);
          return (start == null ? end == null : start is int && start >= 0 && (end == null ? d.status != 'Abgeschlossen' : end is int && end >= start && end <= request.time.toMillis() + 300000)) && (creating || resource.data.get('actual_start_ms',null) == null || start == resource.data.actual_start_ms) && ( (!creating && resource.data.status == 'Abgeschlossen') ? d.status == 'Abgeschlossen' : d.status != 'Abgeschlossen' || (d.get('planning_complete',true) && settled(b,d.id,0) && settled(b,d.id,1) && settled(b,d.id,2) && settled(b,d.id,3) && settled(b,d.id,4) && settled(b,d.id,5)));
        }
        function validCustomerState(d,creating) {
          let a = after(b,'appointments',d.appointment_id);
          return d.id == d.appointment_id + ':' + d.customer_id && d.guard_shard is int && d.guard_shard >= 0 && d.guard_shard < 6 && a.status != 'Abgeschlossen' && d._facility_id == a._facility_id && (creating ? d.status == 'Offen' : d.appointment_id == resource.data.appointment_id && d.customer_id == resource.data.customer_id && d.guard_shard == resource.data.guard_shard) && (d.status in ['Offen','In Behandlung'] ? d.id in guard(b,d.appointment_id,d.guard_shard).pending_ids && (d.status != 'In Behandlung' || after(b,'treatments',d.id).end_ms == null && after(b,'treatments',d.id).appointment_customer_id == d.id) : (d.status == 'Erledigt' ? after(b,'treatments',d.id).end_ms != null && after(b,'treatments',d.id).appointment_customer_id == d.id : d.status == 'Nicht durchgeführt' && d.non_completion_reason is string && d.non_completion_reason.size() > 0 && (!existsAfter(/databases/$(database)/documents/hf_businesses/$(b)/records/$( 'treatments~' + d.id )) || after(b,'treatments',d.id).end_ms != null)));
        }
        function finishedFinance(d) { let f = getAfter(/databases/$(database)/documents/hf_businesses/$(b)/finance/$(d.id)).data; return f.completed == true && f.treatment_id == d.id && f.performed_by == d.performed_by; }
        function validTreatment(d,creating) {
          let m = after(b,'appointment_customers',d.appointment_customer_id);
          let a = after(b,'appointments',d.appointment_id);
