            (resource.data.status == 'In Behandlung' && d.status == 'Erledigt' && after(b,'treatments',resource.data.id).performed_by == request.auth.uid && after(b,'treatments',resource.data.id).end_ms != null && d.diff(resource.data).affectedKeys().hasOnly(['status','_audit_revision']))
